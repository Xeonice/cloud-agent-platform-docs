# container-stack.env 模板：controller 与 linux-ci 两个 compose 项目共用这一份 env 文件。
# 生产副本在 Mac 上：$HOME/.local/share/agent-platform-jenkins-tools/container-stack.env（属主为运维账号，权限 0600）。
# 本模板只列键和说明，值一律留空；不要把真实镜像 ID 写回这里。标准 compose 命令与取值规则见 docs/ops/参考表.md。
# 镜像类的值都是对应 VM 上 Docker daemon 里的不可变镜像 ID（sha256:<64 位十六进制>），不用可变标签。

# controller 项目（jenkins VM，deploy/containers/compose.controller.json）
# Jenkins controller 镜像 ID。
CONTROLLER_IMAGE=
# 生产必须为 active。只接受 migration 或 active；不写时 compose 取 migration，
# 而 migration 模式每次启动都会停用全部作业，并把所有节点设为临时离线（init.groovy.d/10-container-guard.groovy）。
CONTROLLER_MODE=
# Jenkins 系统 URL。只接受 http://127.0.0.1:8080/ 或 https://jenkins.douglasdong.com/，不写时取前者。
AGENT_PLATFORM_JENKINS_URL=

# linux-ci 项目（build VM，deploy/containers/compose.ci.json）
# ARM64 CI agent（服务 agent）的镜像 ID。升级脚本 deploy/ops/upgrade-agents.mjs 会改写它。
CI_IMAGE=
# AMD64 Web CI agent（服务 web）的镜像 ID。升级脚本会改写它。
WEB_CI_IMAGE=
# 两个 CI agent 连接 controller 的 URL，必须在 build VM 内可达。
# 只允许 http 或 https，不得带用户名、口令、查询串或片段（deploy/jenkins/ci-agent-entrypoint.mjs 校验）。
JENKINS_URL=
