# runtime.env 模板：生产 API 容器的运行期配置。它不是本地开发用的 api/.env。
# 生产有两份副本，必须逐字节一致，否则发布在替换 API 之前就会失败（deploy/containers/api-container.mjs 比对两份的哈希）：
#   - agent-platform-api-secrets 卷：API 容器内只读挂在 /run/secrets/runtime.env，属主 root，权限 0600；
#   - agent-platform-linux-deploy-state 卷：deploy agent 内为 /srv/agent-platform/deploy/runtime.env，属主 1000，权限 0600。
# 本模板只列键和说明，值一律留空；口令与密钥的值绝不进仓库。写入、同步与轮换步骤见 docs/ops/运维手册.md。
# 必需键及其固定取值由 api-container.mjs 的 runtimePolicy 校验，不符合就拒绝发布。
# NODE_ENV、SANDBOX_DEFAULT_PROVIDER=boxlite、SANDBOX_DEFAULT_IMAGE 等已在镜像里设置（deploy/containers/Dockerfile.api），这里不必再写。

# 监听与数据目录（固定取值）
# 固定为 127.0.0.1：只在 runtime VM 的回环地址监听，公网流量经 Tunnel 进入。
HOST=
# 固定为 3101。
PORT=
# 固定为 /data。
DATA_ROOT=
# 固定为 /data/platform.db。
DATABASE_URL=
# 固定为 /data/boxlite。
BOXLITE_HOME=
# 固定为 /data/deployment-drain（发布时使用的维护屏障文件）。
DEPLOYMENT_DRAIN_FILE=

# 公网入口与访问口令
# 允许带凭据跨源访问 API 的前端 origin，多个用逗号分隔。
# 每一项都必须以 https:// 开头，且不带路径、通配符、查询串或片段。
API_ALLOWED_ORIGINS=
# 固定为 cloudflare-loopback：只有来自本机回环（Tunnel）的请求，才采信其 CF-Connecting-IP 作为客户端地址。
API_TRUST_PROXY=
# 固定为 false：生产不允许回环来源免口令。
ACCESS_PASSCODE_ALLOW_LOOPBACK=
# 固定为 true：会话 cookie 带 Secure，只经 HTTPS 发送。
PASSCODE_COOKIE_SECURE=
# 秘密：访问口令，必须非空。
ACCESS_PASSCODE=
# 秘密：会话 cookie 的签名密钥，必须非空。更换后，所有已登录的浏览器都要重新输入口令。
PASSCODE_COOKIE_SECRET=

# 可选键
# 只在 ACCESS_PASSCODE 为空、且数据库里还没有口令的首次启动时起作用：不为 false 就自动生成口令并只打印一次。
# 生产的 ACCESS_PASSCODE 必填，所以这个键在生产上不起作用。
ACCESS_PASSCODE_AUTO_GENERATE=
# 为 true 时，API 启动会清理没有数据库记录的遗留沙箱，并接回上个进程留下的运行中任务。
# 不写时 API 启动入口（api 仓 apps/api/src/main.ts）按 true 处理；写成 true 以外的值即关闭。
SANDBOX_RECONCILE_ON_BOOT=
# 生产没有设置这个键，即开启 cgroup 控制器委派。写 off 后，下次重启 API 时跳过委派（deploy/containers/api-cgroup.mjs）；其他值都等于开启。
# API_CGROUP_DELEGATION=
