# Built only from an assembled, public-only context. Linux ARM64 BoxLite 0.9.7.
FROM node:22.23.3-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS node
RUN node -e "if(process.arch!=='arm64')throw Error('Linux ARM64 required')"
RUN apt-get update && apt-get install -y --no-install-recommends python3 patchelf ca-certificates && rm -rf /var/lib/apt/lists/*
COPY boxlite-proof/prepare-runtime.py /tmp/prepare-runtime.py
RUN python3 /tmp/prepare-runtime.py

# Compile SQLite in the same glibc 2.28 environment used by the companion shim.
FROM rockylinux:8@sha256:9794037624aaa6212aeada1d28861ef5e0a935adaf93e4ef79837119f2a2d04c AS builder
RUN dnf install -y python3.11 make gcc-toolset-12-gcc-c++ git tar gzip ca-certificates && dnf clean all
COPY --from=node /usr/local/ /usr/local/
ENV PATH=/opt/rh/gcc-toolset-12/root/usr/bin:/usr/local/bin:/usr/bin:/bin \
    PYTHON=/usr/bin/python3.11 npm_config_build_from_source=true
RUN corepack enable pnpm && corepack prepare pnpm@9.12.0 --activate
WORKDIR /app
COPY manifests/ /app/
RUN pnpm install --frozen-lockfile
COPY api/ /app/
RUN pnpm build && node -e "const D=require('better-sqlite3');const d=new D(':memory:');if(d.prepare('select 1 AS ok').get().ok!==1)throw Error('SQLite failed');d.close();require('node:module').createRequire('/app/packages/modules/sandbox/package.json')('@boxlite-ai/boxlite')"

FROM rockylinux:8@sha256:9794037624aaa6212aeada1d28861ef5e0a935adaf93e4ef79837119f2a2d04c AS runtime
RUN dnf install -y python3 ca-certificates libcap libseccomp libstdc++ git openssh-clients procps-ng tar gzip && dnf clean all
COPY boxlite-proof/materialize-certs.py /tmp/materialize-certs.py
RUN python3 /tmp/materialize-certs.py && rm /tmp/materialize-certs.py
COPY --from=node /usr/local/ /usr/local/
COPY --from=node /opt/boxlite-runtime /opt/boxlite-runtime
WORKDIR /app
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/drizzle ./drizzle
COPY --from=builder /app/package.json ./package.json
COPY api-entrypoint.mjs /opt/agent-platform/api-entrypoint.mjs
RUN node -e "const D=require('better-sqlite3');const d=new D(':memory:');d.close();require('node:module').createRequire('/app/packages/modules/sandbox/package.json')('@boxlite-ai/boxlite')"
ARG APP_COMMIT
ARG APP_BUILT_AT
ENV NODE_ENV=production HOST=127.0.0.1 PORT=3101 \
    DATA_ROOT=/data DATABASE_URL=/data/platform.db BOXLITE_HOME=/data/boxlite \
    BOXLITE_RUNTIME_DIR=/opt/boxlite-runtime SANDBOX_DEFAULT_PROVIDER=boxlite DEPLOYMENT_DRAIN_FILE=/data/deployment-drain \
    SANDBOX_DEFAULT_IMAGE=ghcr.io/xeonice/agent-platform-boxlite:latest \
    SCHEDULER_CPU_OVERCOMMIT=1 APP_COMMIT=$APP_COMMIT APP_VERSION=$APP_COMMIT APP_BUILT_AT=$APP_BUILT_AT
HEALTHCHECK --interval=15s --timeout=5s --start-period=120s --retries=4 CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||'3101')+'/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
ENTRYPOINT ["/usr/local/bin/node", "/opt/agent-platform/api-entrypoint.mjs"]
